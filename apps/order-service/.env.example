# Copy to apps/order-service/.env (ignored). No credentials are needed for step 2.
SERVICE_NAME=order-service
HTTP_PORT=3004
HTTP_HOST=127.0.0.1
APP_ENV=dev
CORS_ORIGINS=["http://localhost:3100"]
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_CONNECTIONS=20
# Internal Catalog batch contract/auth is a draft; configure after producer review.
CATALOG_BASE_URL=http://127.0.0.1:3002
INVENTORY_BASE_URL=http://127.0.0.1:3003
PAYMENT_BASE_URL=http://127.0.0.1:3005
# INVENTORY_SERVICE_TOKEN=
# PAYMENT_SERVICE_TOKEN=
# CATALOG_SERVICE_TOKEN=
# Required for new quotes/orders; no default shipping fee is assumed.
# SHIPPING_FEE_AMOUNT=
# With DATABASE_ENABLED=false no DB connection is opened.
DATABASE_ENABLED=false
BROKER_ENABLED=false
# Enable DATABASE_ENABLED after bootstrap and configuring the runtime URL.
# Broker client is ready when enabled; API never starts consumers.
# DATABASE_URL=
# BROKER_URL=
# Credentials belong only in the ignored .env, never in this template.
# DATABASE_URL=postgresql+asyncpg://order_runtime:PASSWORD@HOST:5432/postgres
# MIGRATION_DATABASE_URL=postgresql+asyncpg://order_migrator:PASSWORD@HOST:5432/postgres
DB_SCHEMA=commerce_orders
DB_SSL_MODE=verify-full
# CA path relative to the repository root (or an absolute path on this machine).
# DB_SSL_CA_FILE=infra/supabase/certs/supabase-ca.crt
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_SECONDS=5
READINESS_TIMEOUT_SECONDS=6

# Local broker: scripts/dev.ps1 infra dev init, then infra dev up.
# Generated host credentials: infra/.local/dev-broker.host.env (ignored).
# BROKER_URL=amqp://commerce_dev:LOCAL_BROKER_PASSWORD@127.0.0.1:5672/commerce_dev
# For cross-machine integration, use the agreed common broker/vhost:
# BROKER_URL=amqps://SERVICE_USER:URL_ENCODED_PASSWORD@BROKER_HOST:5671/DEV_VHOST
BROKER_CONNECT_TIMEOUT_SECONDS=5
BROKER_PUBLISH_TIMEOUT_SECONDS=5
BROKER_RECONNECT_INTERVAL_SECONDS=2
BROKER_PREFETCH_COUNT=10
BROKER_HEARTBEAT_SECONDS=30
BROKER_MAX_MESSAGE_BYTES=262144
# Explicit Order workers: --mode outbox / consumer / all. Default remains monitor.
ORDER_OUTBOX_BATCH_SIZE=20
ORDER_OUTBOX_LEASE_SECONDS=60
ORDER_OUTBOX_MAX_ATTEMPTS=10
ORDER_WORKER_POLL_SECONDS=0.5
ORDER_EVENT_MAX_ATTEMPTS=4
ORDER_EVENT_RETRY_DELAYS_MS=[1000,5000,30000]
# Recovery HTTP response/auth remains a producer-review draft. Opt in after configuring it.
ORDER_RECOVERY_ENABLED=false
ORDER_RECOVERY_BATCH_SIZE=10
ORDER_RECOVERY_STALE_SECONDS=300
ORDER_RECOVERY_LEASE_SECONDS=60
ORDER_RECOVERY_POLL_SECONDS=10
ORDER_RECOVERY_MAX_ATTEMPTS=5
# Optional trusted CA for AMQPS (PEM); hostname verification stays enabled.
# BROKER_SSL_CA_FILE=infra/rabbitmq/certs/dev-ca.crt
