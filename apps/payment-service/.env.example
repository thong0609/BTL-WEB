# Copy to apps/payment-service/.env (ignored). No credentials are needed for step 2.
SERVICE_NAME=payment-service
HTTP_PORT=3005
HTTP_HOST=127.0.0.1
APP_ENV=dev
CORS_ORIGINS=["http://localhost:3100"]
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_CONNECTIONS=20
# With DATABASE_ENABLED=false no DB connection is opened.
DATABASE_ENABLED=false
BROKER_ENABLED=false
# Enable DATABASE_ENABLED after bootstrap and configuring the runtime URL.
# Broker client is ready when enabled; API never starts consumers.
# DATABASE_URL=
# BROKER_URL=
# Credentials belong only in the ignored .env, never in this template.
# DATABASE_URL=postgresql+asyncpg://payment_runtime:PASSWORD@HOST:5432/postgres
# MIGRATION_DATABASE_URL=postgresql+asyncpg://payment_migrator:PASSWORD@HOST:5432/postgres
DB_SCHEMA=commerce_payments
DB_SSL_MODE=verify-full
# Absolute path to the CA downloaded from Supabase Database settings when required.
# DB_SSL_CA_FILE=D:/Single-Store-Ecommerce/infra/supabase/certs/supabase-ca.crt
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_SECONDS=5
READINESS_TIMEOUT_SECONDS=6

# Set only for a broker that belongs to the shared dev environment.
# BROKER_URL=amqps://SERVICE_USER:URL_ENCODED_PASSWORD@BROKER_HOST:5671/DEV_VHOST
BROKER_CONNECT_TIMEOUT_SECONDS=5
BROKER_PUBLISH_TIMEOUT_SECONDS=5
BROKER_RECONNECT_INTERVAL_SECONDS=2
BROKER_PREFETCH_COUNT=10
BROKER_HEARTBEAT_SECONDS=30
BROKER_MAX_MESSAGE_BYTES=262144
# Optional trusted CA for AMQPS (PEM); hostname verification stays enabled.
# BROKER_SSL_CA_FILE=infra/rabbitmq/certs/dev-ca.crt
