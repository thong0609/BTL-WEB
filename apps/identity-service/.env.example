# Copy to apps/identity-service/.env (ignored). No credentials are needed for step 2.
SERVICE_NAME=identity-service
HTTP_PORT=3001
HTTP_HOST=127.0.0.1
APP_ENV=dev
CORS_ORIGINS=["http://localhost:3100"]
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_CONNECTIONS=20
# With DATABASE_ENABLED=false no DB connection is opened.
DATABASE_ENABLED=false
BROKER_ENABLED=false
# Enable DATABASE_ENABLED after bootstrap and configuring the runtime URL.
# Broker checks are still pending step 4.
# DATABASE_URL=
# BROKER_URL=
# Credentials belong only in the ignored .env, never in this template.
# DATABASE_URL=postgresql+asyncpg://identity_runtime:PASSWORD@HOST:5432/postgres
# MIGRATION_DATABASE_URL=postgresql+asyncpg://identity_migrator:PASSWORD@HOST:5432/postgres
DB_SCHEMA=commerce_identity
DB_SSL_MODE=verify-full
# CA path relative to the repository root (or an absolute path on this machine).
# DB_SSL_CA_FILE=infra/supabase/certs/supabase-ca.crt
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_SECONDS=5
READINESS_TIMEOUT_SECONDS=6
# Authentication. Real values belong only in the ignored .env.
JWT_ISSUER=commerce-identity-service
# PEM content of an unencrypted RSA private key (PKCS#8, 2048 bits or more), on ONE line,
# line breaks written as the two characters \n, wrapped in double quotes.
# JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# base64url of 32 random bytes (43 characters).
# OAUTH_COOKIE_SECRET=
# Google OAuth client (dev). The client ID is not secret; the client secret is.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3100/api/v1/auth/google/callback
