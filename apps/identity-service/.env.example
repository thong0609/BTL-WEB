# Copy to apps/identity-service/.env (ignored). No credentials are needed for step 2.
SERVICE_NAME=identity-service
HTTP_PORT=3001
HTTP_HOST=127.0.0.1
APP_ENV=dev
CORS_ORIGINS=["http://localhost:3100"]
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_CONNECTIONS=20
# Disabled means skeleton-only readiness, NOT a verified DB/broker connection.
DATABASE_ENABLED=false
BROKER_ENABLED=false
# Enable flags only when dependency checks are implemented in steps 3/4.
# DATABASE_URL=
# BROKER_URL=
